---
import Base from '../layouts/Base.astro';
import { links, services } from '../config';

const manifesto =
  'Uma marca forte não nasce do acaso. Ela é construída com [clareza], [posicionamento] e intenção — até que as pessoas percebam o seu [valor] antes mesmo de você dizer uma palavra.';
const manifestoWords = manifesto.split(' ').map((w) => {
  const accent = w.startsWith('[');
  return { text: w.replace(/[\[\]]/g, ''), accent };
});
---
<Base>
  <!-- ░░ Grain + cursor ░░ -->
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><span class="cursor__label"></span></div>

  <!-- ░░ Preloader — o obturador ░░ -->
  <div id="loader" aria-hidden="true">
    <div class="loader__inner">
      <p class="loader__kicker"><span>Marca</span><span>em</span><span>foco</span></p>
      <h2 class="loader__name"><span class="loader__word">Flávia</span> <em class="loader__word">Monnar</em></h2>
      <div class="loader__bar"><i></i></div>
      <div class="loader__meta">
        <span>Estrategista de Marca</span>
        <span class="loader__count">000</span>
      </div>
    </div>
  </div>

  <!-- ░░ Navegação ░░ -->
  <header class="nav">
    <a href="#top" class="nav__logo" data-magnetic>
      <span>Flávia</span><em>Monnar</em>
    </a>
    <nav class="nav__links" aria-label="Seções">
      <a href="#sobre" data-link>Sobre</a>
      <a href="#servicos" data-link>Serviços</a>
      <a href="#podcast" data-link>Podcast</a>
    </nav>
    <div class="nav__right">
      <button class="sound" type="button" aria-pressed="false" aria-label="Ativar som do vídeo">
        <span class="sound__bars"><i></i><i></i><i></i><i></i></span>
        <span class="sound__txt">Som</span>
      </button>
      <a href={links.contato} target="_blank" rel="noopener" class="pill" data-magnetic>Fale comigo</a>
    </div>
  </header>

  <main id="top">
    <!-- ░░ HERO ░░ -->
    <section id="hero" class="hero">
      <div class="hero__stage">
        <div class="hero__after" aria-hidden="true">
          <div class="hero__after-l">
            <span class="eyebrow">Há mais de</span>
            <strong class="hero__big">6<sup>+</sup></strong>
            <span class="hero__big-cap">anos construindo marcas</span>
          </div>
          <div class="hero__after-r">
            <span class="eyebrow">Monnar</span>
            <p>Posicionamento sólido, autoridade e percepção de valor por meio do <em>branding estratégico.</em></p>
          </div>
        </div>

        <div class="hero__media" data-cursor="Assistir">
          <video
            class="hero__video"
            src="/video/hero.mp4"
            poster="/video/poster.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="auto"></video>
          <div class="hero__shade"></div>
        </div>

        <div class="viewfinder" aria-hidden="true">
          <i class="vf vf--tl"></i><i class="vf vf--tr"></i><i class="vf vf--bl"></i><i class="vf vf--br"></i>
          <div class="vf__focus"><i></i><i></i></div>
          <div class="vf__read vf__read--l"><span class="rec"></span> Imersão · Palco</div>
          <div class="vf__read vf__read--r">Marca em Foco <b class="vf__tc">00:00:00</b></div>
        </div>

        <div class="hero__content">
          <p class="eyebrow hero__eyebrow">Estrategista de Marca — Fundadora da Monnar</p>
          <h1 class="hero__title">
            <span class="hero__line" data-split>Marcas que</span>
            <span class="hero__line hero__line--it" data-split><em>entram em foco.</em></span>
          </h1>
          <div class="hero__aside">
            <p>Estratégia de marca para empresas e marcas pessoais que querem clareza, autoridade e valor percebido.</p>
            <div class="hero__ctas">
              <a href={links.contato} target="_blank" rel="noopener" class="btn btn--light" data-magnetic>
                <span>Quero posicionar minha marca</span><i class="btn__arrow">→</i>
              </a>
              <button type="button" class="play" data-film data-magnetic>
                <span class="play__ring"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
                <span>Assistir ao filme</span>
              </button>
            </div>
          </div>
        </div>

        <div class="hero__scroll" aria-hidden="true"><span>Role</span><i></i></div>
      </div>
    </section>

    <!-- ░░ MANIFESTO ░░ -->
    <section id="manifesto" class="manifesto">
      <div class="container">
        <p class="label"><span>(01)</span> Manifesto</p>
        <p class="manifesto__text">
          {manifestoWords.map((w) => (
            <span class:list={['mw', { 'mw--accent': w.accent }]}>{w.accent ? <em>{w.text}</em> : w.text} </span>
          ))}
        </p>
        <svg class="curve curve--m" viewBox="0 0 600 900" aria-hidden="true"><path d="M420 0C300 140 520 300 380 470C250 630 60 620 120 900L600 900L600 0Z"/></svg>
      </div>
    </section>

    <!-- ░░ SOBRE ░░ -->
    <section id="sobre" class="about">
      <div class="container about__grid">
        <div class="about__visual">
          <svg class="about__shape" viewBox="0 0 500 700" aria-hidden="true"><path d="M250 0C420 0 500 120 470 260C440 400 330 420 360 560C380 650 300 700 220 700C90 700 0 610 30 470C60 330 150 320 110 190C80 90 130 0 250 0Z"/></svg>
          <figure class="about__photo" data-cursor="Flávia">
            <img src="/images/flavia-1400.webp" srcset="/images/flavia-1400.webp 1400w, /images/flavia-2000.webp 2000w" sizes="(max-width: 900px) 90vw, 40vw" alt="Flávia Monnar falando ao microfone em um evento" loading="lazy" width="1400" height="2100" />
          </figure>
          <div class="badge" aria-hidden="true">
            <svg viewBox="0 0 200 200">
              <defs><path id="circ" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
              <text><textPath href="#circ">Estrategista de Marca • Fundadora da Monnar • </textPath></text>
            </svg>
            <em>fm</em>
          </div>
        </div>

        <div class="about__copy">
          <p class="label"><span>(02)</span> Quem conduz</p>
          <h2 class="about__name" data-split-chars>Flávia <em>Monnar</em></h2>
          <p class="about__role">Estrategista de Marca <span>|</span> Fundadora da Monnar</p>
          <p class="about__lead" data-reveal>
            Fundadora da <strong>Monnar</strong>, empresa especializada em construção de marcas há mais de seis anos. Host do podcast <strong>Marca em Foco</strong>, embaixadora e mentora na comunidade <strong>CEO Delas</strong>.
          </p>
          <p class="about__text" data-reveal>
            Especialista em estratégia de marca para empresas e marcas pessoais, ajudando negócios a construírem posicionamentos sólidos, autoridade e percepção de valor por meio do branding estratégico.
          </p>

          <ul class="creds">
            <li class="cred" data-reveal>
              <span class="cred__num"><b data-count="6">0</b>+</span>
              <span class="cred__txt">anos construindo marcas<small>Fundadora da Monnar</small></span>
            </li>
            <li class="cred" data-reveal>
              <span class="cred__num cred__num--it"><em>Host</em></span>
              <span class="cred__txt">Podcast Marca em Foco<small>Conversas sobre branding</small></span>
            </li>
            <li class="cred" data-reveal>
              <span class="cred__num cred__num--it"><em>Mentora</em></span>
              <span class="cred__txt">Comunidade CEO Delas<small>Embaixadora e mentora</small></span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ░░ SERVIÇOS — cartela de materiais ░░ -->
    <section id="servicos" class="services">
      <div class="services__pin">
        <div class="services__head container">
          <p class="label label--light"><span>(03)</span> Serviços</p>
          <h2 class="services__title" data-split-chars>Cinco caminhos para uma marca que <em>se sustenta.</em></h2>
          <p class="services__hint">Cada marca tem a sua matéria-prima. <span>Arraste a rolagem →</span></p>
        </div>
        <div class="services__track">
          {services.map((s) => (
            <article class:list={['swatch', `swatch--${s.material}`]} data-tilt>
              <div class="swatch__surface" aria-hidden="true"></div>
              <div class="swatch__body">
                <header class="swatch__top">
                  <span class="swatch__n">{s.n}</span>
                  <span class="swatch__tag">{s.tag}</span>
                </header>
                <div>
                  <h3 class="swatch__title">{s.title}</h3>
                  <p class="swatch__text">{s.text}</p>
                  <a href={links.contato} target="_blank" rel="noopener" class="swatch__link">Quero saber mais <i>→</i></a>
                </div>
              </div>
            </article>
          ))}
          <div class="swatch swatch--end">
            <p>Não sabe por onde começar?</p>
            <a href={links.contato} target="_blank" rel="noopener" class="btn btn--gold" data-magnetic><span>Vamos conversar</span><i class="btn__arrow">→</i></a>
          </div>
        </div>
        <div class="services__progress container" aria-hidden="true"><i></i></div>
      </div>
    </section>

    <!-- ░░ EM CENA ░░ -->
    <section id="palco" class="stage">
      <div class="marquee" aria-hidden="true">
        <div class="marquee__row">
          <span>Palestras <em>·</em> Workshops <em>·</em> Imersões <em>·</em> Comunidades <em>·</em>&nbsp;</span>
          <span>Palestras <em>·</em> Workshops <em>·</em> Imersões <em>·</em> Comunidades <em>·</em>&nbsp;</span>
        </div>
      </div>
      <div class="stage__window" data-cursor="Play" data-film>
        <video src="/video/hero.mp4" poster="/video/poster.jpg" muted loop playsinline preload="none" class="stage__video"></video>
        <div class="stage__cap">
          <span class="eyebrow">(04) Em cena</span>
          <p>Conteúdos sobre branding, posicionamento e construção de marcas — levados ao palco para empresas e comunidades.</p>
          <span class="play play--sm"><span class="play__ring"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span><span>Ver o filme com som</span></span>
        </div>
      </div>
    </section>

    <!-- ░░ PODCAST ░░ -->
    <section id="podcast" class="podcast">
      <div class="lens" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
      <div class="container podcast__inner">
        <p class="label label--light"><span>(05)</span> Podcast</p>
        <h2 class="podcast__title">
          <span class="pt pt--1">Marca</span>
          <span class="pt pt--2"><em>em</em></span>
          <span class="pt pt--3">Foco</span>
        </h2>
        <div class="podcast__foot">
          <p data-reveal>Um espaço para falar de branding, posicionamento e construção de marcas — com a clareza de quem vive isso todos os dias.</p>
          <a href={links.podcast} target="_blank" rel="noopener" class="btn btn--light" data-magnetic><span>Ouvir o Marca em Foco</span><i class="btn__arrow">→</i></a>
        </div>
      </div>
    </section>

    <!-- ░░ PARA QUEM ░░ -->
    <section class="audience">
      <div class="container">
        <p class="label"><span>(06)</span> Para quem</p>
        <div class="audience__grid">
          <article class="aud" data-reveal>
            <span class="aud__n">A</span>
            <h3>Empresas</h3>
            <p>Negócios que precisam de um posicionamento claro para crescer, se diferenciar e comunicar o valor real do que entregam.</p>
          </article>
          <article class="aud" data-reveal>
            <span class="aud__n">B</span>
            <h3>Marcas <em>pessoais</em></h3>
            <p>Profissionais que querem construir autoridade e ser reconhecidos pela expertise que têm — com intenção e consistência.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ░░ CTA ░░ -->
    <section id="contato" class="cta">
      <svg class="curve curve--cta" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true"><path d="M0 800C200 560 360 700 560 520C760 340 700 120 980 90C1180 70 1300 200 1440 140L1440 800Z"/></svg>
      <div class="container cta__inner">
        <p class="label"><span>(07)</span> Próximo passo</p>
        <h2 class="cta__title">
          <span class="cta__line" data-split-chars>Vamos colocar</span>
          <span class="cta__line" data-split-chars>a sua marca</span>
          <span class="cta__line cta__line--it" data-split-chars><em>em foco?</em></span>
        </h2>
        <a href={links.contato} target="_blank" rel="noopener" class="orb" data-magnetic data-cursor-hide>
          <span class="orb__txt">Agendar<br/>conversa</span>
          <span class="orb__arrow">↗</span>
        </a>
      </div>
    </section>
  </main>

  <!-- ░░ FOOTER ░░ -->
  <footer class="footer">
    <div class="container footer__top">
      <div>
        <p class="eyebrow">Flávia Monnar</p>
        <p class="footer__claim">Estratégia de marca para quem quer ser <em>percebido</em> pelo valor que entrega.</p>
      </div>
      <ul class="footer__links">
        <li><a href={links.instagram} target="_blank" rel="noopener" data-link>Instagram</a></li>
        <li><a href={links.monnar} target="_blank" rel="noopener" data-link>Monnar</a></li>
        <li><a href={links.podcast} target="_blank" rel="noopener" data-link>Podcast Marca em Foco</a></li>
        <li><a href="#top" data-link>Voltar ao topo ↑</a></li>
      </ul>
    </div>
    <div class="footer__word" aria-hidden="true"><span>Monnar</span></div>
    <div class="container footer__bottom">
      <span>© {new Date().getFullYear()} Flávia Monnar</span>
      <span>Estrategista de Marca · Fundadora da Monnar</span>
    </div>
  </footer>

  <!-- ░░ Modal do filme ░░ -->
  <div class="film" role="dialog" aria-modal="true" aria-label="Filme" hidden>
    <button class="film__close" type="button" aria-label="Fechar">Fechar <i>✕</i></button>
    <div class="film__frame">
      <video class="film__video" src="/video/film.mp4" controls playsinline preload="none" poster="/video/poster.jpg"></video>
    </div>
  </div>

  <script>
    import '../scripts/main.ts';
  </script>
</Base>
